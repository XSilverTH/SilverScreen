# Maintainer: XSilverTH
# NOTE: AUR -git package — NOT yet tested by the maintainer.
# Do not upload to the AUR until build() and package() have been verified
# in a clean Arch x86_64 chroot.
# A stable-tarball package (silverscreen, from the vX.Y.Z tag tarball built
# by .github/workflows/tag.yml) is next once the current tag is published;
# see the commented alternative at the bottom of this file. Both variants
# need a maintainer chroot test before any AUR upload.

pkgname=silverscreen-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Native GTK4 YouTube client that plays videos with MPV'
arch=('x86_64')
url='https://github.com/XSilverTH/SilverScreen'
license=('GPL-3.0-or-later')
depends=('gtk4' 'libadwaita' 'webkitgtk-6.0' 'libsoup3' 'libsecret' 'mpv' 'yt-dlp' 'hicolor-icon-theme')
makedepends=('git' 'dotnet-sdk>=10' 'blueprint-compiler' 'glib2' 'clang')
provides=('silverscreen')
conflicts=('silverscreen')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd SilverScreen
  local desc
  if desc=$(git describe --long --tags 2>/dev/null); then
    printf '%s' "$desc" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

prepare() {
  cd SilverScreen
  git submodule update --init --recursive
}

build() {
  cd SilverScreen
  export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
  dotnet publish src/SilverScreen.App/SilverScreen.App.csproj \
    -c Release -r linux-x64 --self-contained \
    -o "$srcdir/SilverScreen/publish"
}

package() {
  cd SilverScreen
  install -Dm755 "publish/SilverScreen" "$pkgdir/usr/bin/SilverScreen"
  ln -s SilverScreen "$pkgdir/usr/bin/silverscreen"
  install -Dm644 packaging/io.github.silverscreen.SilverScreen.desktop \
    "$pkgdir/usr/share/applications/io.github.silverscreen.SilverScreen.desktop"
  install -Dm644 packaging/io.github.silverscreen.SilverScreen.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.silverscreen.SilverScreen.metainfo.xml"
  install -Dm644 packaging/io.github.silverscreen.SilverScreen.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.silverscreen.SilverScreen.svg"
}

# Stable-tarball note:
# Source builds require git submodules (lib/YoutubeAPI and lib/Hi3Helper.SharpDiscordRPC).
# GitHub's auto-generated archive tarballs (/archive/refs/tags/v$pkgver.tar.gz) do NOT include
# submodules and cannot be used directly for building from source.
# A source tarball must either be generated with submodules bundled, or git source with
# submodules must be used.
