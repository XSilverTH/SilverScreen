using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog PreferencesDialog {
  content-width: 600;
  content-height: 500;

  Adw.PreferencesPage {
    title: "General";
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: "Appearance";

      Adw.ComboRow theme_row {
        notify => $OnRowNotify();
        title: "Application Theme";
        subtitle: "Select your preferred color scheme";
        model: Gtk.StringList theme_model {
          strings: ["System", "Light", "Dark"];
        };
      }
    }

    Adw.PreferencesGroup {
      title: "Search (yt-dlp)";

      Adw.EntryRow ytdlp_path_row {
        changed => $OnRowChanged();
        title: "yt-dlp Executable Path";
      }

      Adw.EntryRow max_results_row {
        changed => $OnRowChanged();
        title: "Max Search Results";
      }
    }
  }

  Adw.PreferencesPage {
    title: "Playback";
    icon-name: "media-playback-start-symbolic";

    Adw.PreferencesGroup {
      title: "Player";

      Adw.ComboRow playback_backend_row {
        notify => $OnRowNotify();
        title: "Playback mode";
        subtitle: "Choose whether videos open in MPV or in SilverScreen";
        model: Gtk.StringList playback_backend_model {
          strings: ["External MPV", "Embedded Player"];
        };
      }

      Adw.SwitchRow fullscreen_row {
        notify => $OnRowNotify();
        title: "Open videos in fullscreen";
        subtitle: "Automatically start video playback in full screen";
      }

      Adw.SwitchRow auto_advance_next_video_row {
        notify => $OnRowNotify();
        title: "Automatically play next video";
        subtitle: "Advance to the next video in the playlist when the current video ends";
      }
    }

    Adw.PreferencesGroup {
      title: "SponsorBlock";
      description: "Uses SponsorBlock data from https://sponsor.ajay.app/";

      Adw.SwitchRow sponsorblock_auto_skip_row {
        notify => $OnRowNotify();
        title: "Automatically skip segments";
        subtitle: "Seek past matching SponsorBlock segments during playback";
      }

      Adw.SwitchRow sponsorblock_display_row {
        notify => $OnRowNotify();
        title: "Show segments on the timeline";
        subtitle: "Display matching SponsorBlock segments in the embedded player's timeline";
      }

      Adw.SwitchRow sponsorblock_sponsor_row {
        notify => $OnRowNotify();
        title: "Sponsors";
      }

      Adw.SwitchRow sponsorblock_selfpromo_row {
        notify => $OnRowNotify();
        title: "Self-promotion";
      }

      Adw.SwitchRow sponsorblock_interaction_row {
        notify => $OnRowNotify();
        title: "Interaction reminders";
      }

      Adw.SwitchRow sponsorblock_intro_row {
        notify => $OnRowNotify();
        title: "Intros and intermissions";
      }

      Adw.SwitchRow sponsorblock_outro_row {
        notify => $OnRowNotify();
        title: "Outros and credits";
      }

      Adw.SwitchRow sponsorblock_preview_row {
        notify => $OnRowNotify();
        title: "Previews and recaps";
      }

      Adw.SwitchRow sponsorblock_hook_row {
        notify => $OnRowNotify();
        title: "Hooks";
      }

      Adw.SwitchRow sponsorblock_filler_row {
        notify => $OnRowNotify();
        title: "Filler";
      }
    }

    Adw.PreferencesGroup {
      title: "MPV Configuration";

      Adw.EntryRow mpv_path_row {
        changed => $OnRowChanged();
        title: "MPV Executable Path";
      }
    }

    Adw.PreferencesGroup {
      title: "Quality";

      Adw.ComboRow quality_row {
        notify => $OnRowNotify();
        title: "Default Quality";
        subtitle: "Preferred video resolution";
        model: Gtk.StringList quality_model {
          strings: ["Best", "1080p", "720p", "480p", "360p"];
        };
      }
    }

    Adw.PreferencesGroup {
      title: "YouTube";

      Adw.SwitchRow mark_watched_row {
        notify => $OnRowNotify();
        title: "Mark watched on YouTube";
        subtitle: "Use your signed-in session to add played videos to watch history";
      }

      Adw.SwitchRow youtube_playback_telemetry_row {
        notify => $OnRowNotify();
        title: "Send playback activity to YouTube";
        subtitle: "Send live watch progress to improve recommendations; cannot be used with Mark watched on YouTube";
      }
    }

    Adw.PreferencesGroup {
      title: "Discord";

      Adw.SwitchRow discord_rich_presence_row {
        notify => $OnRowNotify();
        title: "Share playback activity on Discord";
        subtitle: "Show the current video in your Discord profile";
      }
    }
  }
}
