using Gtk 4.0;
using Adw 1;

Gtk.Box HomeView {
  orientation: vertical;
  hexpand: true;
  vexpand: true;
  
  Gtk.Box home_search_bar {
    visible: false;
    spacing: 12;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 24;
    margin-end: 24;

    Gtk.SearchEntry home_search_entry {
      placeholder-text: "Search or paste a YouTube URL";
      hexpand: true;
      activate => $OnHomeSearchEntryActivated();
    }
  }


  Gtk.Box home_status_host {
    visible: false;
    orientation: vertical;
    hexpand: true;
    vexpand: true;

    Gtk.Box home_status_loading_page {
      visible: false;
      orientation: vertical;
      spacing: 12;
      halign: center;
      valign: center;
      hexpand: true;
      vexpand: true;

      Gtk.Spinner home_status_loading_spinner {
        halign: center;
        spinning: true;
      }
    }

    Adw.StatusPage home_status_page {
      visible: false;
      title: "Home";
      hexpand: true;
      vexpand: true;
    }
  }

  Gtk.ScrolledWindow home_scrolled_window {
    visible: false;
    hexpand: true;
    vexpand: true;
    child: Gtk.GridView home_video_grid {
      min-columns: 1;
      max-columns: 4;
      single-click-activate: false;
      margin-start: 24;
      margin-end: 24;
      margin-top: 12;
      hexpand: true;
      vexpand: true;
    };
  }

}
