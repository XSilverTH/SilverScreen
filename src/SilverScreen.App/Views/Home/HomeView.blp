using Gtk 4.0;
using Adw 1;

Gtk.Box HomeView {
  orientation: vertical;
  hexpand: true;
  vexpand: true;

  Gtk.Box home_status_host {
    visible: false;
    orientation: vertical;
    hexpand: true;
    vexpand: true;

    Gtk.Box home_status_loading_page {
      visible: false;
      orientation: vertical;
      spacing: 12;
      halign: center;
      valign: center;
      hexpand: true;
      vexpand: true;

      Gtk.Spinner home_status_loading_spinner {
        halign: center;
        spinning: true;
      }
    }

    Adw.StatusPage home_status_page {
      visible: false;
      title: "Home";
      hexpand: true;
      vexpand: true;
    }
  }

  Gtk.Overlay home_content_overlay {
    visible: false;
    hexpand: true;
    vexpand: true;

    child: Gtk.ScrolledWindow home_scrolled_window {
      hexpand: true;
      vexpand: true;

      child: Gtk.GridView home_video_grid {
        min-columns: 1;
        max-columns: 4;
        single-click-activate: false;
        margin-start: 24;
        margin-end: 24;
        margin-top: 12;
        hexpand: true;
        vexpand: true;
      };
    };

    [overlay]
    Gtk.Revealer home_pagination_loading_revealer {
      halign: center;
      valign: end;
      reveal-child: false;
      transition-type: crossfade;
      transition-duration: 200;
      margin-bottom: 24;

      child: Gtk.Box {
        halign: center;
        spacing: 10;
        can-focus: false;
        styles ["pagination-loading-pill"]

        Gtk.Spinner {
          spinning: true;
          width-request: 16;
          height-request: 16;
        }

        Gtk.Label home_pagination_loading_label {
          label: "Loading more videos…";
          styles ["caption", "dim-label"]
        }
      };
    }
  }
}
