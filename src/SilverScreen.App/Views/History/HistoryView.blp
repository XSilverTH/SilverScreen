using Gtk 4.0;
using Adw 1;

Gtk.Box HistoryView {
  orientation: vertical;
  hexpand: true;
  vexpand: true;

  Gtk.Stack history_stack {
    hexpand: true;
    vexpand: true;

    Gtk.StackPage {
      name: "loading";
      child: Gtk.Box history_loading_page {
        orientation: vertical;
        spacing: 12;
        halign: center;
        valign: center;
        hexpand: true;
        vexpand: true;

        Gtk.Spinner history_loading_spinner {
          spinning: true;
          halign: center;
        }

        Gtk.Label {
          label: "Loading watch history…";
          styles ["dim-label"]
        }
      };
    }

    Gtk.StackPage {
      name: "content";
      child: Gtk.Overlay history_content_overlay {
        hexpand: true;
        vexpand: true;

        child: Gtk.ScrolledWindow history_scrolled_window {
          hexpand: true;
          vexpand: true;

          child: Gtk.GridView history_video_grid {
            min-columns: 1;
            max-columns: 4;
            single-click-activate: false;
            margin-start: 24;
            margin-end: 24;
            margin-top: 12;
            margin-bottom: 12;
            hexpand: true;
            vexpand: true;
          };
        };

        [overlay]
        Gtk.Revealer history_pagination_loading_revealer {
          halign: center;
          valign: end;
          reveal-child: false;
          transition-type: crossfade;
          transition-duration: 200;
          margin-bottom: 24;

          child: Gtk.Box {
            halign: center;
            spacing: 10;
            can-focus: false;
            styles ["pagination-loading-pill"]

            Gtk.Spinner {
              spinning: true;
              width-request: 16;
              height-request: 16;
            }

            Gtk.Label history_pagination_loading_label {
              label: "Loading more history…";
              styles ["caption", "dim-label"]
            }
          };
        }
      };
    }

    Gtk.StackPage {
      name: "signed_out";
      child: Adw.StatusPage history_signed_out_page {
        icon-name: "avatar-default-symbolic";
        title: "Sign in to see history";
        description: "Watch history requires an active YouTube session.";
      };
    }

    Gtk.StackPage {
      name: "empty";
      child: Adw.StatusPage history_empty_page {
        icon-name: "document-open-recent-symbolic";
        title: "No watch history";
        description: "Videos you watch on YouTube will appear here.";
      };
    }

    Gtk.StackPage {
      name: "error";
      child: Adw.StatusPage history_error_page {
        icon-name: "network-error-symbolic";
        title: "Could not load history";
        description: "Failed to load your watch history. Check your network connection and try again.";

        child: Gtk.Button history_retry_button {
          label: "Retry";
          halign: center;
          clicked => $OnRetryButtonClicked();
          styles ["suggested-action"]
        };
      };
    }
  }
}
