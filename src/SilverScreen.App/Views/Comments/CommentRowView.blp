using Gtk 4.0;

Gtk.Box CommentRowView {
  orientation: horizontal;
  hexpand: true;
  styles ["queue-row"]
  margin-top: 3;
  margin-bottom: 3;
  margin-start: 8;
  margin-end: 8;

  Gtk.Box {
    orientation: horizontal;
    spacing: 12;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;
    hexpand: true;

    Gtk.Image {
      icon-name: "avatar-default-symbolic";
      pixel-size: 32;
      valign: start;
    }

    Gtk.Box {
      orientation: vertical;
      spacing: 4;
      hexpand: true;

      Gtk.Label comment_author_label {
        xalign: 0;
        ellipsize: end;
        styles ["heading"]
      }

      Gtk.Label comment_published_time_label {
        xalign: 0;
        styles ["caption", "dim-label"]
      }

      Gtk.Label comment_text_label {
        xalign: 0;
        wrap: true;
        selectable: true;
      }

      Gtk.Box {
        orientation: horizontal;
        spacing: 6;
        margin-top: 4;

        Gtk.Image {
          resource: "/SilverScreen/Assets/like-symbolic.svg";
          pixel-size: 16;
        }

        Gtk.Label comment_likes_label {
          xalign: 0;
          styles ["caption", "dim-label"]
        }
      }
      Gtk.Button comment_replies_button {
        halign: start;
        visible: false;
        clicked => $OnRepliesButtonClicked();
        styles ["flat"]
      }
    }
  }
}
