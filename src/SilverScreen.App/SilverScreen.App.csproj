<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <SupportedOSPlatform>linux</SupportedOSPlatform>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <PublishAot>true</PublishAot>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>SilverScreen</AssemblyName>
        <RootNamespace>SilverScreen</RootNamespace>
        <Version>0.1.0</Version>
        <InformationalVersion>0.1.0</InformationalVersion>
        <Authors>XSilverTH</Authors>
        <Copyright>Copyright © XSilverTH</Copyright>
        <Description>A GTK 4 and Libadwaita desktop app for YouTube</Description>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/XSilverTH/SilverScreen</PackageProjectUrl>
        <RepositoryUrl>https://github.com/XSilverTH/SilverScreen.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    </PropertyGroup>

    <ItemGroup>
        <Compile Update="**\*.cs">
            <DependentUpon>%(Filename).blp</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GirCore.Adw-1"/>
        <PackageReference Include="XSTH.Blueprint.Helpers"/>
        <PackageReference Include="Serilog"/>
        <PackageReference Include="Serilog.Sinks.Console"/>
        <PackageReference Include="Serilog.Sinks.File"/>
        <PackageReference Include="Tmds.DBus.Generator"/>
        <PackageReference Include="Tmds.DBus.Protocol"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <InternalsVisibleTo Include="SilverScreen.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="Dbus/org.mpris.MediaPlayer2.xml" Namespace="SilverScreen.DBus" DBusGeneratorMode="Handler"/>
        <AdditionalFiles Include="Dbus/org.mpris.MediaPlayer2.Player.xml" Namespace="SilverScreen.DBus" DBusGeneratorMode="Handler"/>
        <AdditionalFiles Include="Dbus/org.freedesktop.portal.xml" Namespace="SilverScreen.DBus" DBusGeneratorMode="Proxy"/>
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Namespace"/>
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="GenerateDBusTypes"/>
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="DBusGeneratorMode"/>
    </ItemGroup>

    <ItemGroup>
        <GResource Include="Assets\*"/>
        <GResource Include="Styles\*"/>
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\SilverScreen.Core\SilverScreen.Core.csproj"/>
        <ProjectReference Include="..\SilverScreen.Infrastructure\SilverScreen.Infrastructure.csproj"/>
    </ItemGroup>

    <Target Name="CompileAuthHelper" BeforeTargets="LinkNative"
            Inputs="$(MSBuildProjectDirectory)/Auth/auth.c"
            Outputs="$(IntermediateOutputPath)auth.o">
        <PropertyGroup>
            <AuthCC Condition="'$(CC)' != ''">$(CC)</AuthCC>
            <AuthCC Condition="'$(AuthCC)' == ''">cc</AuthCC>
        </PropertyGroup>
        <MakeDir Directories="$(IntermediateOutputPath)"/>
        <Exec Command="$(AuthCC) -c -fPIC -O2 $(MSBuildProjectDirectory)/Auth/auth.c -o $(IntermediateOutputPath)auth.o `pkg-config --cflags gtk4 webkitgtk-6.0 libsoup-3.0`"/>
    </Target>
    <Target Name="CompileAuthHelperShared" AfterTargets="Build" Condition="'$(_IsPublishing)' != 'true'"
            Inputs="$(MSBuildProjectDirectory)/Auth/auth.c"
            Outputs="$(TargetDir)libauth_helper.so">
        <PropertyGroup>
            <AuthCC Condition="'$(CC)' != ''">$(CC)</AuthCC>
            <AuthCC Condition="'$(AuthCC)' == ''">cc</AuthCC>
        </PropertyGroup>
        <Exec Command="$(AuthCC) -shared -fPIC -O2 $(MSBuildProjectDirectory)/Auth/auth.c -o $(TargetDir)libauth_helper.so `pkg-config --cflags --libs gtk4 webkitgtk-6.0 libsoup-3.0`" />
    </Target>


    <ItemGroup>
        <NativeLibrary Include="$(IntermediateOutputPath)auth.o" Visible="false"/>
        <NativeSystemLibrary Include="gtk-4;webkitgtk-6.0;soup-3.0;glib-2.0;gobject-2.0;gio-2.0" Visible="false"/>
        <DirectPInvoke Include="auth_helper" Visible="false"/>
    </ItemGroup>
</Project>
