using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow MainWindow {
  default-width: 1180;
  default-height: 760;
  title: "SilverScreen";

  Adw.Breakpoint breakpoint {
    condition ("max-width: 550sp")

    setters {
      view_switcher_bar.reveal: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Gtk.Stack main_stack {
      Gtk.StackPage {
        name: "shell";

        child: Adw.OverlaySplitView queue_split_view {
          sidebar-position: end;
          collapsed: true;

          content: Adw.ToolbarView toolbar_view {
            content: Gtk.Box navigation_host {
              hexpand: true;
              vexpand: true;
            };

            [bottom]
            Adw.ViewSwitcherBar view_switcher_bar {
            }
          };

          sidebar: Gtk.Box queue_sidebar_host {
            hexpand: false;
            vexpand: true;
          };
        };
      }

      Gtk.StackPage {
        name: "player";

        child: Gtk.Box player_host {
          hexpand: true;
          vexpand: true;
        };
      }
    };
  };
}
