using Gtk 4.0;
using Adw 1;

Adw.Bin VideoListView {
  hexpand: true;
  vexpand: true;

  Gtk.Stack video_list_stack {
    hexpand: true;
    vexpand: true;

    Gtk.StackPage {
      name: "loading";

      child: Gtk.Box video_list_loading_page {
        orientation: vertical;
        spacing: 12;
        halign: center;
        valign: center;
        hexpand: true;
        vexpand: true;

        Gtk.Spinner video_list_loading_spinner {
          spinning: true;
          halign: center;
        }

        Gtk.Label video_list_loading_label {
          styles [
            "dim-label",
          ]
        }
      };
    }

    Gtk.StackPage {
      name: "content";

      child: Gtk.Overlay video_list_content_overlay {
        hexpand: true;
        vexpand: true;

        child: Gtk.ScrolledWindow video_list_scrolled_window {
          hexpand: true;
          vexpand: true;

          child: Gtk.GridView video_list_grid {
            min-columns: 1;
            max-columns: 8;
            single-click-activate: false;
            margin-start: 24;
            margin-end: 24;
            margin-top: 12;
            margin-bottom: 12;
            hexpand: true;
            vexpand: true;
          };
        };

        [overlay]
        Gtk.Revealer video_list_pagination_loading_revealer {
          halign: center;
          valign: end;
          reveal-child: false;
          transition-type: crossfade;
          transition-duration: 200;
          margin-bottom: 24;

          child: Gtk.Box {
            halign: center;
            spacing: 10;
            can-focus: false;

            styles [
              "pagination-loading-pill",
            ]

            Gtk.Spinner {
              spinning: true;
              width-request: 16;
              height-request: 16;
            }

            Gtk.Label video_list_pagination_loading_label {
              label: "Loading more videos…";

              styles [
                "caption",
                "dim-label",
              ]
            }
          };
        }
      };
    }

    Gtk.StackPage {
      name: "status";

      child: Adw.StatusPage video_list_status_page {
        hexpand: true;
        vexpand: true;

        child: Gtk.Button video_list_retry_button {
          label: "Retry";
          halign: center;
          clicked => $OnRetryButtonClicked();

          styles [
            "suggested-action",
          ]
        };
      };
    }
  }
}
