using Gtk 4.0;
using Adw 1;

Adw.Bin VideoCardView {
  width-request: 310;
  halign: fill;
  valign: start;
  hexpand: true;
  margin-start: 10;
  margin-end: 10;
  margin-top: 12;
  margin-bottom: 12;

  Gtk.Box card {
    orientation: vertical;
    width-request: 310;
    halign: fill;
    valign: start;
    hexpand: true;
    focusable: true;
    styles [
      "video-card",
    ]
    overflow: hidden;
  }
}
