using Gtk 4.0;

Gtk.Box ChannelView {
  orientation: vertical;
  hexpand: true;
  vexpand: true;

  styles [
    "channel-view",
  ]

  Gtk.Revealer channel_header_revealer {
    reveal-child: true;
    transition-type: slide_down;
    transition-duration: 250;

    child: Gtk.Box channel_header {
      orientation: vertical;
      spacing: 16;
      margin-start: 24;
      margin-end: 24;
      margin-top: 16;
      margin-bottom: 8;

      styles [
        "channel-header-card",
      ]

      Gtk.Box channel_profile_box {
        orientation: horizontal;
        spacing: 20;
        valign: start;

        Gtk.Overlay channel_avatar_overlay {
          width-request: 80;
          height-request: 80;
          halign: start;
          valign: start;

          styles [
            "channel-avatar",
          ]

          child: Gtk.Image channel_avatar_placeholder {
            icon-name: "avatar-default-symbolic";
            pixel-size: 48;
            halign: center;
            valign: center;
          };
        }

        Gtk.Box channel_meta_details {
          orientation: vertical;
          spacing: 4;
          hexpand: true;
          valign: start;

          Gtk.Label channel_name {
            xalign: 0;
            wrap: true;
            selectable: true;

            styles [
              "channel-title",
            ]
          }

          Gtk.Box channel_sub_meta {
            orientation: horizontal;
            spacing: 8;
            halign: start;

            Gtk.Label channel_handle {
              xalign: 0;
              visible: false;

              styles [
                "dim-label",
                "caption",
              ]
            }

            Gtk.Label channel_meta_dot1 {
              label: "•";
              visible: false;

              styles [
                "dim-label",
                "caption",
              ]
            }

            Gtk.Label channel_subscribers {
              xalign: 0;
              visible: false;

              styles [
                "dim-label",
                "caption",
              ]
            }
          }

          Gtk.ScrolledWindow channel_description_scroller {
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;
            max-content-height: 80;
            propagate-natural-height: true;
            hexpand: true;
            visible: false;
            margin-top: 4;

            styles [
              "channel-description-scroller",
            ]

            Gtk.TextView channel_description {
              editable: false;
              cursor-visible: false;
              wrap-mode: word;
              accepts-tab: false;
              monospace: false;
              top-margin: 0;
              bottom-margin: 0;
              left-margin: 0;
              right-margin: 0;

              styles [
                "channel-description",
              ]
            }
          }
        }
      }

      Gtk.Box channel_controls_bar {
        orientation: horizontal;
        spacing: 12;
        margin-top: 8;

        Gtk.Label sort_label {
          label: "Sort by:";

          styles [
            "dim-label",
          ]
        }

        Gtk.DropDown channel_sort_dropdown {
          notify => $OnSortDropdownNotify();

          model: Gtk.StringList {
            strings: [
              "Newest",
              "Oldest",
              "Popular",
            ];
          };

          selected: 0;
        }
      }
    };
  }

  Gtk.Box channel_video_list_host {
    hexpand: true;
    vexpand: true;
  }
}
