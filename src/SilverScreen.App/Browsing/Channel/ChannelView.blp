using Gtk 4.0;

Gtk.Box ChannelView {
  orientation: vertical;
  hexpand: true;
  vexpand: true;

  styles [
    "channel-view",
  ]

  Gtk.Revealer channel_header_revealer {
    reveal-child: true;
    transition-type: slide_down;
    transition-duration: 250;

    child: Gtk.Box channel_header {
      orientation: vertical;
      spacing: 16;
      margin-start: 24;
      margin-end: 24;
      margin-top: 16;
      margin-bottom: 8;

      styles [
        "channel-header-card",
      ]

      Gtk.Box channel_profile_box {
        orientation: horizontal;
        spacing: 20;
        valign: start;

        Gtk.Overlay channel_avatar_overlay {
          width-request: 80;
          height-request: 80;
          halign: start;
          valign: start;

          styles [
            "channel-avatar",
          ]

          child: Gtk.Image channel_avatar_placeholder {
            icon-name: "avatar-default-symbolic";
            pixel-size: 48;
            halign: center;
            valign: center;
          };
        }

        Gtk.Box channel_meta_details {
          orientation: vertical;
          spacing: 4;
          hexpand: true;
          valign: start;

          Gtk.Label channel_name {
            xalign: 0;
            wrap: true;
            selectable: true;

            styles [
              "channel-title",
            ]
          }

          Gtk.Box channel_sub_meta {
            orientation: horizontal;
            spacing: 8;
            halign: start;

            Gtk.Label channel_handle {
              xalign: 0;
              visible: false;

              styles [
                "dim-label",
                "caption",
              ]
            }

            Gtk.Label channel_meta_dot1 {
              label: "•";
              visible: false;

              styles [
                "dim-label",
                "caption",
              ]
            }

            Gtk.Label channel_subscribers {
              xalign: 0;
              visible: false;

              styles [
                "dim-label",
                "caption",
              ]
            }
          }

          Gtk.ScrolledWindow channel_description_scroller {
            hscrollbar-policy: never;
            vscrollbar-policy: automatic;
            max-content-height: 80;
            propagate-natural-height: true;
            hexpand: true;
            visible: false;
            margin-top: 4;

            styles [
              "channel-description-scroller",
            ]

            Gtk.TextView channel_description {
              editable: false;
              cursor-visible: false;
              wrap-mode: word;
              accepts-tab: false;
              monospace: false;
              top-margin: 0;
              bottom-margin: 0;
              left-margin: 0;
              right-margin: 0;

              styles [
                "channel-description",
              ]
            }
          }
        }
      }

      Gtk.Box channel_controls_bar {
        orientation: horizontal;
        spacing: 12;
        margin-top: 8;

        Gtk.Label sort_label {
          label: "Sort by:";

          styles [
            "dim-label",
          ]
        }

        Gtk.DropDown channel_sort_dropdown {
          notify => $OnSortDropdownNotify();

          model: Gtk.StringList {
            strings: [
              "Newest",
              "Oldest",
              "Popular",
            ];
          };

          selected: 0;
        }

        Gtk.Box channel_controls_spacer {
          hexpand: true;
        }

        Gtk.MenuButton channel_about_button {
          label: "About";
          icon-name: "dialog-information-symbolic";
          tooltip-text: "About channel";

          styles [
            "flat",
          ]

          popover: Gtk.Popover channel_about_popover {
            child: Gtk.Box channel_about_box {
              orientation: vertical;
              spacing: 12;
              width-request: 320;
              margin-start: 12;
              margin-end: 12;
              margin-top: 12;
              margin-bottom: 12;

              Gtk.Label about_channel_title {
                xalign: 0;
                wrap: true;

                styles [
                  "heading",
                ]
              }

              Gtk.Box about_meta_box {
                orientation: vertical;
                spacing: 4;

                Gtk.Label about_handle_label {
                  xalign: 0;
                  wrap: true;
                  selectable: true;
                  visible: false;

                  styles [
                    "caption",
                    "dim-label",
                  ]
                }

                Gtk.Label about_subscribers_label {
                  xalign: 0;
                  selectable: true;
                  visible: false;

                  styles [
                    "caption",
                    "dim-label",
                  ]
                }
              }

              Gtk.Box about_links_section {
                orientation: vertical;
                spacing: 6;

                Gtk.Label about_links_header {
                  label: "Links";
                  xalign: 0;

                  styles [
                    "dim-label",
                    "caption-heading",
                  ]
                }

                Gtk.LinkButton about_channel_link {
                  halign: start;
                  visible: false;
                }
              }

              Gtk.Box about_contact_section {
                orientation: vertical;
                spacing: 4;
                visible: false;

                Gtk.Label about_contact_header {
                  label: "Contact";
                  xalign: 0;

                  styles [
                    "dim-label",
                    "caption-heading",
                  ]
                }

                Gtk.Label about_contact_label {
                  xalign: 0;
                  wrap: true;
                  selectable: true;

                  styles [
                    "caption",
                  ]
                }
              }

              Gtk.Box about_description_section {
                orientation: vertical;
                spacing: 4;
                visible: false;

                Gtk.Label about_description_header {
                  label: "Description";
                  xalign: 0;

                  styles [
                    "dim-label",
                    "caption-heading",
                  ]
                }

                Gtk.ScrolledWindow about_description_scroller {
                  hscrollbar-policy: never;
                  vscrollbar-policy: automatic;
                  max-content-height: 180;
                  propagate-natural-height: true;

                  Gtk.Label about_description_label {
                    xalign: 0;
                    wrap: true;
                    selectable: true;

                    styles [
                      "caption",
                    ]
                  }
                }
              }
            };
          };
        }
      }
    };
  }

  Gtk.Box channel_video_list_host {
    hexpand: true;
    vexpand: true;
  }
}
