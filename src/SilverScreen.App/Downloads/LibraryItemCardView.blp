using Gtk 4.0;
using Adw 1;

Adw.Bin LibraryItemCardView {
  width-request: 310;
  halign: fill;
  valign: start;
  hexpand: true;
  margin-start: 10;
  margin-end: 10;
  margin-top: 12;
  margin-bottom: 12;

  Gtk.Box card {
    orientation: vertical;
    width-request: 310;
    halign: fill;
    valign: start;
    hexpand: true;
    focusable: true;

    styles [
      "video-card",
    ]

    overflow: hidden;

    Gtk.Overlay thumb_overlay {
      height-request: 189;
      hexpand: true;
      overflow: hidden;

      styles [
        "video-thumbnail",
      ]

      child: Gtk.Image placeholder {
        icon-name: "media-playback-start-symbolic";
        pixel-size: 44;
        halign: center;
        valign: center;
        accessible-role: presentation;
      };

      [overlay]
      Gtk.Label format_pill {
        halign: start;
        valign: end;
        margin-start: 10;
        margin-bottom: 9;

        styles [
          "caption",
          "duration-pill",
        ]
      }

      [overlay]
      Gtk.Label duration_label {
        halign: end;
        valign: end;
        margin-end: 10;
        margin-bottom: 9;

        styles [
          "caption",
          "duration-pill",
        ]
      }
    }

    Gtk.Overlay {
      margin-start: 12;
      margin-end: 12;
      margin-top: 9;
      margin-bottom: 10;

      styles [
        "video-metadata",
      ]

      child: Gtk.Box {
        orientation: vertical;
        spacing: 2;
        hexpand: true;

        Gtk.Label title_label {
          xalign: 0;
          wrap: true;
          max-width-chars: 30;
          height-request: 38;

          styles [
            "video-title",
          ]
        }

        Gtk.Box {
          orientation: horizontal;
          spacing: 8;
          hexpand: true;

          Gtk.Label channel_label {
            xalign: 0;
            hexpand: true;
            wrap: false;
            ellipsize: end;
            focusable: true;

            styles [
              "dim-label",
              "channel-link",
            ]
          }

          Gtk.Label size_label {
            xalign: 1;
            halign: end;
            wrap: false;

            styles [
              "dim-label",
            ]
          }
        }
      };

      [overlay]
      Gtk.MenuButton menu_button {
        icon-name: "view-more-symbolic";
        halign: end;
        valign: start;

        styles [
          "flat",
        ]
      }
    }
  }
}
