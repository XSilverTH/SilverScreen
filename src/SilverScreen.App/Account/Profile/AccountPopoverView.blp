using Gtk 4.0;
using Adw 1;

Adw.Bin AccountPopoverView {
  margin-top: 12;
  margin-bottom: 12;
  margin-start: 12;
  margin-end: 12;

  styles [
    "account-popover",
  ]

  Gtk.Stack account_stack {
    hhomogeneous: false;
    vhomogeneous: false;

    Gtk.StackPage {
      name: "status";
      child: Adw.Bin status_host {};
    }

    Gtk.StackPage {
      name: "signed_in";
      child: Adw.Bin signed_in_host {};
    }

    Gtk.StackPage {
      name: "manual";
      child: Adw.Bin manual_host {};
    }
  }
}
