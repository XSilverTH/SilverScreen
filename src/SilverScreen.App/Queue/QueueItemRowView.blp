using Gtk 4.0;

menu queue_item_actions {
  item {
    label: "Play now";
    action: "queue.play-now";
  }
  item {
    label: "Move up";
    action: "queue.move-up";
  }
  item {
    label: "Move down";
    action: "queue.move-down";
  }
  item {
    label: "Remove";
    action: "queue.remove";
  }
}

Gtk.Box QueueItemRowView {
  hexpand: true;
  styles ["queue-row"]
  spacing: 8;
  margin-top: 3;
  margin-bottom: 3;
  margin-start: 8;
  margin-end: 8;
  height-request: 78;
  valign: start;

  Image grip {
    icon-name: "list-drag-handle-symbolic";
    tooltip-text: "Drag to reorder";
    margin-start: 2;
    margin-end: 2;
    valign: center;
  }

  Gtk.Stack state_stack {
    valign: center;
    width-request: 20;
    hhomogeneous: true;
    vhomogeneous: true;

    Gtk.StackPage {
      name: "index";
      child: Gtk.Label position {
        label: "";
        styles ["caption", "dim-label"]
        halign: center;
        valign: center;
      };
    }

    Gtk.StackPage {
      name: "playing";
      child: Gtk.Image playing_icon {
        icon-name: "audio-volume-high-symbolic";
        tooltip-text: "Now playing";
        halign: center;
        valign: center;
        styles ["queue-now-playing-icon"]
      };
    }
  }

  Overlay thumbnail {
    width-request: 96;
    height-request: 54;
    styles ["queue-thumbnail"]
    overflow: hidden;
    child: Image placeholder {
      icon-name: "media-playback-start-symbolic";
      halign: center;
      valign: center;
    };

    [overlay]
    Gtk.ProgressBar watched_progress {
      halign: fill;
      valign: end;
      visible: false;
      show-text: false;
      styles ["watched-progress-bar", "queue-progress-bar"]
    }

    [overlay]
    Gtk.Label duration_pill {
      label: "";
      halign: end;
      valign: end;
      margin-end: 4;
      margin-bottom: 4;
      styles ["caption", "queue-duration-pill"]
    }
  }

  Box details {
    orientation: vertical;
    spacing: 3;
    hexpand: true;
    valign: center;

    Label title {
      label: "";
      xalign: 0;
      lines: 2;
      ellipsize: end;
      wrap: true;
      hexpand: true;
    }

    Box metadata {
      orientation: horizontal;
      spacing: 6;

      Label channel {
        label: "";
        xalign: 0;
        ellipsize: end;
        hexpand: true;
        styles ["caption", "dim-label"]
      }

      Label duration {
        label: "";
        xalign: 1;
        styles ["caption", "dim-label"]
      }
    }
  }

  Button remove_button {
    icon-name: "user-trash-symbolic";
    tooltip-text: "Remove from queue";
    styles ["flat", "circular"]
    valign: center;
    clicked => $OnRemoveButtonClicked();
  }

  MenuButton menu {
    icon-name: "view-more-symbolic";
    tooltip-text: "Queue item actions";
    styles ["flat", "circular"]
    valign: center;
    menu-model: queue_item_actions;
  }
}
