using Gtk 4.0;
using Adw 1;

Gtk.Box CommentsView {
  orientation: vertical;
  width-request: 380;
  vexpand: true;

  styles [
    "queue-panel",
  ]

  Gtk.Box {
    orientation: horizontal;
    spacing: 12;
    margin-start: 16;
    margin-end: 16;
    margin-top: 16;
    margin-bottom: 12;

    Adw.Bin {
      hexpand: true;

      Gtk.Label {
        label: "Comments";
        xalign: 0;

        styles [
          "title-3",
        ]
      }
    }

    Gtk.Button comments_close_button {
      icon-name: "window-close-symbolic";
      tooltip-text: "Close comments";
      clicked => $OnCloseButtonClicked();

      styles [
        "flat",
        "circular",
      ]
    }
  }

  Gtk.Box {
    orientation: horizontal;
    spacing: 8;
    margin-start: 16;
    margin-end: 16;
    margin-bottom: 12;

    Gtk.DropDown comments_sort_dropdown {
      hexpand: true;
      notify => $OnSortDropdownNotify();

      model: Gtk.StringList {
        strings: [
          "Top comments",
          "Newest first",
        ];
      };

      selected: 0;
    }

    Gtk.Button comments_compose_button {
      icon-name: "document-edit-symbolic";
      tooltip-text: "Add a comment";
      valign: center;
      clicked => $OnComposeButtonClicked();

      styles [
        "flat",
        "circular",
      ]
    }
  }

  Gtk.Revealer comments_composer_revealer {
    reveal-child: false;
    transition-type: slide_down;
    transition-duration: 200;

    child: Adw.Bin {
      margin-start: 8;
      margin-end: 8;
      margin-bottom: 12;

      styles [
        "comment-row",
        "comment-composer-card",
      ]

      Gtk.Box {
        orientation: vertical;
        spacing: 12;
        margin-top: 12;
        margin-bottom: 12;
        margin-start: 12;
        margin-end: 12;

        Gtk.Box {
          orientation: horizontal;
          spacing: 12;
          hexpand: true;

          Adw.Avatar comments_composer_avatar {
            size: 32;
            show-initials: true;
            valign: start;
            accessible-role: presentation;
          }

          Gtk.Overlay {
            hexpand: true;

            child: Gtk.ScrolledWindow {
              hexpand: true;
              hscrollbar-policy: never;
              vscrollbar-policy: automatic;
              propagate-natural-height: true;
              min-content-height: 54;
              max-content-height: 140;

              child: Gtk.TextView comments_composer_text {
                wrap-mode: word;
                accepts-tab: false;
                hexpand: true;

                styles [
                  "comment-composer-text",
                ]
              };
            };

            [overlay]
            Gtk.Label comments_composer_placeholder {
              label: "Add a comment...";
              halign: start;
              valign: start;
              can-target: false;

              styles [
                "dim-label",
              ]
            }
          }
        }

        Gtk.Label comments_composer_error_label {
          visible: false;
          wrap: true;
          xalign: 0;

          styles [
            "caption",
            "error",
          ]
        }

        Gtk.Box {
          orientation: horizontal;
          spacing: 8;
          halign: end;

          Gtk.Button comments_composer_submit_button {
            label: "Comment";
            sensitive: false;
            clicked => $OnComposerSubmitClicked();

            styles [
              "suggested-action",
              "comment-composer-button",
            ]
          }
        }
      }
    };
  }

  Gtk.Stack comments_stack {
    hexpand: true;
    vexpand: true;

    Gtk.StackPage {
      name: "unavailable";

      child: Adw.StatusPage {
        icon-name: "comments-symbolic";
        title: "Comments unavailable";
        description: "Play a YouTube video to view comments.";
      };
    }

    Gtk.StackPage {
      name: "loading";

      child: Adw.Bin {
        halign: center;
        valign: center;

        Gtk.Spinner comments_loading_spinner {
          spinning: true;
        }
      };
    }

    Gtk.StackPage {
      name: "list";

      child: Gtk.Overlay comments_list_overlay {
        hexpand: true;
        vexpand: true;

        child: Gtk.ScrolledWindow comments_scrolled_window {
          hexpand: true;
          vexpand: true;

          child: Gtk.ListView comments_list {
            single-click-activate: false;

            styles [
              "comments-list",
            ]
          };
        };

        [overlay]
        Gtk.Revealer comments_pagination_loading_revealer {
          halign: center;
          valign: end;
          reveal-child: false;
          transition-type: crossfade;
          transition-duration: 200;
          margin-bottom: 16;

          child: Gtk.Box {
            halign: center;
            spacing: 10;
            can-focus: false;

            styles [
              "pagination-loading-pill",
            ]

            Gtk.Spinner {
              spinning: true;
              width-request: 16;
              height-request: 16;
            }

            Gtk.Label comments_pagination_loading_label {
              label: "Loading more comments…";

              styles [
                "caption",
                "dim-label",
              ]
            }
          };
        }
      };
    }

    Gtk.StackPage {
      name: "empty";

      child: Adw.StatusPage comments_empty_page {
        icon-name: "comments-symbolic";
        title: "No comments";
        description: "No comments are available for this video.";
      };
    }

    Gtk.StackPage {
      name: "error";

      child: Adw.StatusPage comments_error_page {
        icon-name: "dialog-error-symbolic";
        title: "Couldn’t load comments";
        description: "Try again shortly.";

        child: Gtk.Button comments_error_retry_button {
          label: "Retry";
          clicked => $OnRetryButtonClicked();

          styles [
            "suggested-action",
          ]
        };
      };
    }
  }

  Gtk.Box {
    orientation: horizontal;
    visible: false;
    spacing: 8;
    margin-start: 16;
    margin-end: 16;
    margin-top: 12;
    margin-bottom: 16;

    Gtk.ScrolledWindow {
      hexpand: true;
      hscrollbar-policy: never;
      vscrollbar-policy: automatic;

      Gtk.TextView comments_draft_text {
        wrap-mode: word;
        top-margin: 8;
        bottom-margin: 8;
        left-margin: 8;
        right-margin: 8;
      }
    }

    Gtk.Button {
      label: "Post";
      sensitive: false;
      tooltip-text: "Posting comments is not available yet.";
      valign: end;
    }
  }
}
