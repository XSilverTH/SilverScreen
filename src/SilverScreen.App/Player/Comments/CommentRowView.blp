using Gtk 4.0;
using Adw 1;

Gtk.Box CommentRowView {
  orientation: horizontal;
  hexpand: true;
  margin-start: 8;
  margin-end: 8;

  Adw.Bin comment_card {
    hexpand: true;
    focusable: true;
    styles [
      "comment-row",
    ]

    Gtk.Box {
      orientation: vertical;
      hexpand: true;

      Gtk.Overlay comment_card_overlay {
        hexpand: true;

        child: Gtk.Box {
          orientation: horizontal;
          hexpand: true;

          Gtk.DrawingArea comment_tree_gutter {
            visible: false;
            vexpand: true;
            can-target: false;
          }

          Gtk.Box comment_content_box {
          orientation: horizontal;
          spacing: 12;
          margin-top: 12;
          margin-bottom: 12;
          margin-start: 12;
          margin-end: 12;
          hexpand: true;

          Adw.Avatar comment_avatar {
            size: 32;
            show-initials: true;
            valign: start;
            accessible-role: presentation;
          }

          Gtk.Box {
            orientation: vertical;
            spacing: 4;
            hexpand: true;

            Gtk.Box {
              orientation: horizontal;
              spacing: 8;
              hexpand: true;

              Gtk.Box {
                orientation: vertical;
                spacing: 2;
                hexpand: true;

                Gtk.Label comment_author_label {
                  xalign: 0;
                  ellipsize: end;

                  styles [
                    "heading",
                  ]
                }

                Gtk.Label comment_published_time_label {
                  xalign: 0;

                  styles [
                    "caption",
                    "dim-label",
                  ]
                }
              }

              Gtk.Box {
                orientation: horizontal;
                spacing: 8;
                valign: start;
                halign: end;

                Gtk.Button comment_translate_button {
                  valign: center;
                  visible: false;
                  tooltip-text: "Translate comment";
                  clicked => $OnTranslateButtonClicked();

                  styles [
                    "flat",
                    "square",
                  ]

                  Gtk.Image comment_translate_icon {
                    resource: "/SilverScreen/Assets/translate-symbolic.svg";
                    pixel-size: 16;
                    accessible-role: presentation;
                  }
                }

                Gtk.Button comment_like_button {
                  valign: center;
                  clicked => $OnLikeButtonClicked();
                  tooltip-text: "Like comment";

                  styles [
                    "flat",
                    "comment-like-button",
                  ]

                  Gtk.Box {
                    orientation: horizontal;
                    spacing: 6;

                    Gtk.Image comment_like_icon {
                      resource: "/SilverScreen/Assets/like-symbolic.svg";
                      pixel-size: 16;
                      accessible-role: presentation;
                    }

                    Gtk.Label comment_header_likes_label {
                      xalign: 0;

                      styles [
                        "caption",
                        "dim-label",
                      ]
                    }
                  }
                }

                Gtk.MenuButton comment_more_button {
                  valign: center;
                  visible: false;
                  icon-name: "view-more-symbolic";
                  tooltip-text: "Comment actions";

                  styles [
                    "flat",
                    "square",
                  ]

                  popover: Gtk.Popover comment_more_popover {
                    Gtk.Box {
                      orientation: vertical;
                      spacing: 4;
                      margin-top: 4;
                      margin-bottom: 4;
                      margin-start: 4;
                      margin-end: 4;

                      Gtk.Button comment_edit_button {
                        visible: false;
                        clicked => $OnEditButtonClicked();

                        styles [
                          "flat",
                        ]

                        Gtk.Box {
                          orientation: horizontal;
                          spacing: 8;

                          Gtk.Image {
                            icon-name: "document-edit-symbolic";
                            pixel-size: 16;
                            accessible-role: presentation;
                          }

                          Gtk.Label {
                            label: "Edit";
                            xalign: 0;
                          }
                        }
                      }

                      Gtk.Button comment_delete_button {
                        visible: false;
                        clicked => $OnDeleteButtonClicked();

                        styles [
                          "flat",
                          "error",
                        ]

                        Gtk.Box {
                          orientation: horizontal;
                          spacing: 8;

                          Gtk.Image {
                            icon-name: "user-trash-symbolic";
                            pixel-size: 16;
                            accessible-role: presentation;
                          }

                          Gtk.Label {
                            label: "Delete";
                            xalign: 0;
                          }
                        }
                      }
                    }
                  };
                }
              }
            }

            Gtk.Overlay comment_body_overlay {
              hexpand: true;

              child: Gtk.ScrolledWindow comment_text_clip {
                hexpand: true;
                hscrollbar-policy: never;
                vscrollbar-policy: never;
                propagate-natural-height: true;

                child: Gtk.Label comment_text_label {
                  xalign: 0;
                  yalign: 0;
                  wrap: true;
                  wrap-mode: word;
                  selectable: true;
                  use-markup: true;
                  activate-link => $OnCommentTextActivateLink();
                };
              };

              [overlay]
              Gtk.Box comment_text_fade {
                hexpand: true;
                valign: end;
                height-request: 44;
                can-target: false;
                visible: false;

                styles [
                  "comment-text-fade",
                ]
              }
            }

            Gtk.Box comment_edit_box {
              orientation: vertical;
              spacing: 8;
              visible: false;

              Gtk.ScrolledWindow {
                hexpand: true;
                hscrollbar-policy: never;
                vscrollbar-policy: automatic;
                propagate-natural-height: true;
                min-content-height: 54;
                max-content-height: 140;

                child: Gtk.TextView comment_edit_text {
                  wrap-mode: word;
                  accepts-tab: false;
                  hexpand: true;

                  styles [
                    "comment-composer-text",
                  ]
                };
              }

              Gtk.Label comment_edit_error_label {
                visible: false;
                wrap: true;
                xalign: 0;

                styles [
                  "caption",
                  "error",
                ]
              }

              Gtk.Box {
                orientation: horizontal;
                spacing: 8;
                halign: end;

                Gtk.Button comment_edit_cancel_button {
                  label: "Cancel";
                  clicked => $OnEditCancelClicked();

                  styles [
                    "comment-composer-button",
                  ]
                }

                Gtk.Button comment_edit_save_button {
                  label: "Save";
                  clicked => $OnEditSaveClicked();

                  styles [
                    "suggested-action",
                    "comment-composer-button",
                  ]
                }
              }
            }

            Gtk.Box comment_delete_confirm_box {
              orientation: horizontal;
              spacing: 8;
              visible: false;
              margin-top: 4;

              Gtk.Label {
                label: "Delete this comment?";
                xalign: 0;
                hexpand: true;

                styles [
                  "caption",
                  "dim-label",
                ]
              }

              Gtk.Button comment_delete_cancel_button {
                label: "Cancel";
                clicked => $OnDeleteCancelClicked();

                styles [
                  "comment-composer-button",
                ]
              }

              Gtk.Button comment_delete_confirm_button {
                label: "Delete";
                clicked => $OnDeleteConfirmClicked();

                styles [
                  "destructive-action",
                  "comment-composer-button",
                ]
              }
            }

            Gtk.Label comment_action_error_label {
              visible: false;
              wrap: true;
              xalign: 0;

              styles [
                "caption",
                "error",
              ]
            }

            Gtk.Box comment_inline_actions_box {
              orientation: horizontal;
              spacing: 8;
              margin-top: 2;
              visible: false;

              Gtk.Button comment_nested_replies_button {
                halign: start;
                visible: false;
                clicked => $OnNestedRepliesButtonClicked();
                styles [
                  "flat",
                  "comment-replies-button",
                ]

                Gtk.Box {
                  orientation: horizontal;
                  spacing: 6;

                  Gtk.Image comment_nested_replies_chevron {
                    icon-name: "pan-down-symbolic";
                    pixel-size: 14;
                    accessible-role: presentation;
                  }

                  Gtk.Label comment_nested_replies_label {
                    label: "";
                  }
                }
              }

              Gtk.Button comment_load_more_replies_button {
                halign: start;
                visible: false;
                clicked => $OnLoadMoreRepliesButtonClicked();
                styles [
                  "flat",
                  "comment-replies-button",
                ]

                Gtk.Label comment_load_more_replies_label {
                  label: "Load more replies";
                }
              }
            }
          }
        }
      };

      [overlay]
      Gtk.Revealer comment_expand_revealer {
          halign: center;
          valign: end;
          reveal-child: false;
          transition-type: slide_up;
          transition-duration: 180;
          can-target: false;

          styles [
            "comment-expand-revealer",
          ]

          child: Gtk.Button comment_expand_button {
            margin-bottom: 8;
            clicked => $OnExpandCollapseButtonClicked();

            styles [
              "pill",
              "comment-expand-pill",
            ]

            Gtk.Box {
              orientation: horizontal;
              spacing: 6;

              Gtk.Image comment_expand_icon {
                icon-name: "pan-down-symbolic";
                pixel-size: 14;
                accessible-role: presentation;
              }

              Gtk.Label comment_expand_label {
                label: "Expand";
              }
            }
          };
        }
      }

      Gtk.Separator comment_thread_divider {
        orientation: horizontal;
        visible: false;
        margin-start: 12;
        margin-end: 12;
      }

      Gtk.Button comment_replies_button {
        hexpand: true;
        visible: false;
        clicked => $OnRepliesButtonClicked();
        styles [
          "flat",
          "comment-replies-footer",
        ]

        Gtk.Box {
          orientation: horizontal;
          spacing: 6;
          halign: center;

          Gtk.Image comment_replies_chevron {
            icon-name: "pan-down-symbolic";
            pixel-size: 14;
            accessible-role: presentation;
          }

          Gtk.Label comment_replies_label {
            label: "";
          }
        }
      }
    }
  }
}
