using Gtk 4.0;
using Adw 1;

Adw.OverlaySplitView EmbeddedPlayerView {
  sidebar-position: start;
  collapsed: true;
  focusable: true;

  sidebar: Gtk.Box comments_sidebar_host {
    hexpand: false;
    vexpand: true;
  };

  content: Adw.OverlaySplitView player_queue_split_view {
    sidebar-position: end;
    collapsed: true;
    focusable: true;

    sidebar: Gtk.Box player_queue_sidebar_host {
      hexpand: false;
      vexpand: true;
    };

    content: Gtk.Overlay {
      hexpand: true;
      vexpand: true;

      styles [
        "embedded-player",
      ]

      child: Gtk.GLArea player_surface {
        auto-render: false;
        hexpand: true;
        vexpand: true;
        realize => $OnPlayerSurfaceRealize();
        unrealize => $OnPlayerSurfaceUnrealize();
        render => $OnPlayerSurfaceRender();

        styles [
          "embedded-player-surface",
        ]
      };

      [overlay]
      Adw.Bin player_loading_indicator {
        halign: center;
        valign: center;
        visible: false;

        styles [
          "player-loading-indicator",
        ]

        Gtk.Spinner {
          spinning: true;
          width-request: 40;
          height-request: 40;
        }
      }

      [overlay]
      Adw.HeaderBar player_header_bar {
        valign: start;

        styles [
          "flat",
          "player-headerbar",
        ]

        [start]
        Gtk.Button player_back_button {
          clicked => $OnBackButtonClicked();
          icon-name: "go-previous-symbolic";
          tooltip-text: "Back to SilverScreen";

          styles [
            "flat",
            "player-overlay-button",
          ]
        }

        [end]
        Gtk.Button player_fullscreen_button {
          clicked => $OnFullscreenButtonClicked();
          icon-name: "view-fullscreen-symbolic";
          tooltip-text: "Toggle fullscreen (F)";

          styles [
            "flat",
            "player-overlay-button",
          ]
        }
      }

      [overlay]
      Gtk.Box player_center_controls {
        spacing: 24;
        halign: center;
        valign: center;

        styles [
          "player-center-controls",
        ]

        Gtk.Button player_rewind_button {
          clicked => $OnRewindButtonClicked();
          icon-name: "media-seek-backward-symbolic";
          tooltip-text: "Rewind 10 seconds (← or J)";

          styles [
            "flat",
            "player-overlay-button",
            "player-seek-button",
          ]
        }

        Gtk.Button player_play_pause_button {
          clicked => $OnPlayPauseButtonClicked();
          icon-name: "media-playback-pause-symbolic";
          tooltip-text: "Play (Space or K)";

          styles [
            "flat",
            "player-primary-control",
          ]
        }

        Gtk.Button player_forward_button {
          clicked => $OnForwardButtonClicked();
          icon-name: "media-seek-forward-symbolic";
          tooltip-text: "Forward 10 seconds (→ or L)";

          styles [
            "flat",
            "player-overlay-button",
            "player-seek-button",
          ]
        }
      }

      [overlay]
      Gtk.Box player_controls {
        orientation: vertical;
        spacing: 10;
        hexpand: true;
        halign: fill;
        valign: end;

        styles [
          "player-controls",
        ]

        Gtk.Box player_metadata_row {
          spacing: 16;
          valign: center;

          Gtk.Box player_metadata {
            orientation: vertical;
            spacing: 2;
            width-request: 320;

            Gtk.Label player_title_label {
              label: "Nothing playing";
              xalign: 0;
              ellipsize: end;

              styles [
                "title-4",
                "player-title",
              ]
            }

            Gtk.Button player_channel_button {
              clicked => $OnPlayerChannelButtonClicked();
              tooltip-text: "Open channel";
              halign: start;

              styles [
                "flat",
                "player-channel-button",
              ]

              child: Gtk.Label player_channel_label {
                label: "Choose a video to preview the embedded player.";
                xalign: 0;
                ellipsize: end;

                styles [
                  "player-subtitle",
                ]
              };
            }
          }

          Gtk.Box player_queue_controls {
            spacing: 2;
            valign: center;
            visible: false;

            styles [
              "player-queue-controls",
            ]

            Gtk.Button player_previous_queue_button {
              clicked => $OnPreviousQueueButtonClicked();
              icon-name: "media-skip-backward-symbolic";
              tooltip-text: "Previous video (P)";

              styles [
                "flat",
                "player-overlay-button",
              ]
            }

            Gtk.ToggleButton player_queue_button {
              icon-name: "view-list-symbolic";
              tooltip-text: "Up next (Q)";

              styles [
                "flat",
                "player-overlay-button",
                "player-queue-toggle",
              ]
            }

            Gtk.Button player_next_queue_button {
              clicked => $OnNextQueueButtonClicked();
              icon-name: "media-skip-forward-symbolic";
              tooltip-text: "Next video (N)";

              styles [
                "flat",
                "player-overlay-button",
              ]
            }
          }

          Gtk.Box {
            hexpand: true;
          }

          Gtk.Box player_reactions {
            spacing: 2;
            valign: center;

            Gtk.Button player_like_button {
              clicked => $OnLikeButtonClicked();
              tooltip-text: "Like this video on YouTube";

              styles [
                "flat",
                "player-reaction-button",
              ]

              child: Gtk.Box {
                spacing: 6;

                Gtk.Image player_like_image {
                  resource: "/SilverScreen/Assets/like-symbolic.svg";
                  pixel-size: 18;
                }

                Gtk.Label player_likes_label {
                  label: "—";

                  styles [
                    "player-reaction-count",
                  ]
                }
              };
            }

            Gtk.Button player_dislike_button {
              clicked => $OnDislikeButtonClicked();
              tooltip-text: "Dislike this video on YouTube";

              styles [
                "flat",
                "player-reaction-button",
              ]

              child: Gtk.Box {
                spacing: 6;

                Gtk.Image player_dislike_image {
                  resource: "/SilverScreen/Assets/dislike-symbolic.svg";
                  pixel-size: 18;
                }

                Gtk.Label player_dislikes_label {
                  label: "—";

                  styles [
                    "player-reaction-count",
                  ]
                }
              };
            }

            Gtk.Button player_subtitle_button {
              clicked => $OnSubtitleButtonClicked();
              icon-name: "subtitles-symbolic";
              tooltip-text: "Use preferred subtitles (C)";
              sensitive: false;

              styles [
                "flat",
                "player-overlay-button",
              ]
            }

            Gtk.MenuButton player_volume_button {
              icon-name: "audio-volume-high-symbolic";
              tooltip-text: "Volume (M mutes; ↑/↓ adjust)";

              styles [
                "flat",
                "player-overlay-button",
              ]

              popover: Gtk.Popover player_volume_popover {
                child: Gtk.Box {
                  orientation: vertical;
                  spacing: 8;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 12;
                  margin-end: 12;
                  width-request: 180;

                  Gtk.Label {
                    label: "Volume";
                    xalign: 0;

                    styles [
                      "heading",
                    ]
                  }

                  Gtk.Scale player_volume_scale {
                    value-changed => $OnVolumeScaleValueChanged();
                    draw-value: false;

                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 100;
                      value: 100;
                      step-increment: 5;
                    };
                  }
                };
              };
            }

            Gtk.MenuButton {
              icon-name: "preferences-system-symbolic";
              tooltip-text: "Player settings ([/]: speed)";

              styles [
                "flat",
                "player-overlay-button",
              ]

              popover: Gtk.Popover player_settings_popover {
                child: Gtk.Box {
                  orientation: vertical;
                  spacing: 12;
                  margin-top: 12;
                  margin-bottom: 12;
                  margin-start: 12;
                  margin-end: 12;
                  width-request: 240;

                  Gtk.Label {
                    label: "Player settings";
                    xalign: 0;

                    styles [
                      "heading",
                    ]
                  }

                  Gtk.Box {
                    orientation: horizontal;
                    spacing: 12;

                    Gtk.Label {
                      label: "Quality";
                      xalign: 0;
                      hexpand: true;
                    }

                    Gtk.DropDown player_quality_dropdown {
                      notify => $OnQualityDropdownNotify();

                      model: Gtk.StringList {
                        strings: [
                          "Best",
                          "1080p",
                          "720p",
                          "480p",
                          "360p",
                        ];
                      };
                    }
                  }

                  Gtk.Box {
                    orientation: vertical;
                    spacing: 6;

                    Gtk.Box {
                      orientation: horizontal;
                      spacing: 12;

                      Gtk.Label {
                        label: "Playback speed";
                        xalign: 0;
                        hexpand: true;
                      }

                      Gtk.Label player_speed_label {
                        label: "1×";
                        xalign: 1;
                      }
                    }

                    Gtk.Scale player_speed_scale {
                      value-changed => $OnSpeedScaleValueChanged();
                      draw-value: false;

                      adjustment: Gtk.Adjustment {
                        lower: 0.25;
                        upper: 5;
                        value: 1;
                        step-increment: 0.25;
                        page-increment: 0.25;
                      };
                    }

                    Gtk.Box {
                      orientation: horizontal;

                      Gtk.Label {
                        label: "0.25×";
                        xalign: 0;
                        hexpand: true;

                        styles [
                          "caption",
                          "dim-label",
                        ]
                      }

                      Gtk.Label {
                        label: "5×";
                        xalign: 1;

                        styles [
                          "caption",
                          "dim-label",
                        ]
                      }
                    }
                  }

                  Gtk.Box {
                    orientation: horizontal;
                    spacing: 12;

                    Gtk.Label {
                      label: "Subtitles";
                      xalign: 0;
                      hexpand: true;
                    }

                    Gtk.DropDown player_subtitle_dropdown {
                      notify => $OnSubtitleDropdownNotify();

                      model: Gtk.StringList player_subtitle_model {
                        strings: [
                          "Off",
                        ];
                      };
                    }
                  }
                };
              };
            }
          }
        }

        Gtk.Overlay player_timeline_overlay {
          child: Gtk.Scale player_timeline {
            draw-value: false;
            hexpand: true;
            sensitive: false;

            adjustment: Gtk.Adjustment {
              lower: 0;
              upper: 100;
              value: 0;
              step-increment: 1;
            };
          };

          [overlay]
          Gtk.Box player_scrub_cue {
            orientation: vertical;
            spacing: 2;
            halign: start;
            valign: end;
            margin-bottom: 24;
            visible: false;
            can-target: false;

            styles [
              "player-scrub-cue",
            ]

            Gtk.Box {
              orientation: horizontal;
              spacing: 8;
              halign: center;

              Gtk.Label player_scrub_time_label {
                label: "0:00";

                styles [
                  "player-scrub-time-label",
                ]
              }

              Gtk.Label player_scrub_delta_label {
                label: "+0:00";
                visible: false;

                styles [
                  "player-scrub-delta-label",
                ]
              }
            }

            Gtk.Label player_scrub_chapter_label {
              label: "";
              visible: false;
              ellipsize: end;
              max-width-chars: 32;

              styles [
                "player-scrub-chapter-label",
              ]
            }
          }
        }

        Gtk.Box player_time_row {
          Gtk.Label player_position_label {
            label: "0:00";
            xalign: 0;
            hexpand: true;

            styles [
              "caption",
              "player-time",
            ]
          }

          Gtk.Label player_duration_label {
            label: "0:00";
            xalign: 1;

            styles [
              "caption",
              "player-time",
            ]
          }
        }
      }

      [overlay]
      Gtk.Button player_info_backdrop {
        visible: false;
        halign: fill;
        valign: fill;
        clicked => $OnInfoBackdropClicked();

        styles [
          "player-info-backdrop",
        ]
      }

      [overlay]
      Gtk.Revealer player_info_revealer {
        halign: fill;
        valign: end;
        hexpand: true;
        reveal-child: false;
        transition-type: slide_up;
        transition-duration: 250;

        child: Gtk.Box player_info_panel {
          orientation: vertical;
          spacing: 10;
          margin-top: 16;
          margin-bottom: 16;
          margin-start: 16;
          margin-end: 16;
          width-request: 420;
          height-request: 300;

          styles [
            "player-info-panel",
          ]

          Gtk.Box {
            spacing: 12;
            valign: center;

            Gtk.Box {
              orientation: vertical;
              spacing: 2;
              hexpand: true;

              Gtk.Label player_info_title_label {
                label: "Video details";
                xalign: 0;
                ellipsize: end;

                styles [
                  "title-4",
                ]
              }

              Gtk.Button player_info_channel_button {
                clicked => $OnInfoChannelButtonClicked();
                tooltip-text: "Open channel";
                halign: start;

                styles [
                  "flat",
                  "player-channel-button",
                ]

                child: Gtk.Label player_info_channel_label {
                  label: "";
                  xalign: 0;
                  ellipsize: end;

                  styles [
                    "caption",
                    "dim-label",
                  ]
                };
              }
            }

            Gtk.Button player_info_close_button {
              clicked => $OnInfoCloseButtonClicked();
              icon-name: "window-close-symbolic";
              tooltip-text: "Close video details (Escape)";

              styles [
                "flat",
                "player-overlay-button",
              ]
            }
          }

          Gtk.Label player_info_stats_label {
            label: "";
            xalign: 0;
            wrap: true;

            styles [
              "caption",
              "dim-label",
            ]
          }

          Gtk.Label player_info_status_label {
            label: "Move to the bottom edge to reveal video details.";
            xalign: 0;
            wrap: true;

            styles [
              "dim-label",
            ]
          }

          Gtk.ScrolledWindow player_info_description_scroller {
            hexpand: true;
            vexpand: true;
            visible: false;
            propagate-natural-height: true;

            Gtk.TextView player_info_description {
              editable: false;
              cursor-visible: false;
              wrap-mode: word;
              accepts-tab: false;
              monospace: false;
              top-margin: 4;
              bottom-margin: 4;
              left-margin: 4;
              right-margin: 4;

              styles [
                "player-info-description",
              ]
            }
          }
        };
      }

      [overlay]
      Gtk.Revealer player_info_cue_revealer {
        reveal-child: false;
        transition-type: slide_up;
        transition-duration: 200;
        halign: center;
        valign: end;

        child: Gtk.Button player_info_cue_button {
          halign: center;
          valign: end;
          margin-bottom: 0;
          clicked => $OnInfoCueButtonClicked();
          tooltip-text: "Show video details (D)";

          styles [
            "player-info-cue-button",
          ]

          child: Adw.Bin {
            halign: center;
            valign: end;

            styles [
              "player-info-cue-handle",
            ]

            Gtk.Image {
              icon-name: "info-symbolic";
              pixel-size: 16;

              styles [
                "player-info-cue-icon",
              ]
            }
          };
        };
      }

      [overlay]
      Gtk.Revealer player_comments_cue_revealer {
        reveal-child: false;
        transition-type: slide_right;
        transition-duration: 200;
        halign: start;
        valign: center;

        child: Gtk.Button player_comments_cue_button {
          halign: start;
          valign: center;
          margin-start: 0;
          clicked => $OnCommentsCueButtonClicked();
          tooltip-text: "Comments";

          styles [
            "player-comments-cue-button",
          ]

          child: Adw.Bin {
            halign: start;
            valign: center;

            styles [
              "player-comments-cue-handle",
            ]

            Gtk.Image {
              icon-name: "comments-symbolic";
              pixel-size: 16;

              styles [
                "player-comments-cue-icon",
              ]
            }
          };
        };
      }

      [overlay]
      Gtk.Box player_prompt_stack {
        orientation: vertical;
        spacing: 8;
        halign: end;
        valign: end;
        margin-end: 0;
        margin-bottom: 24;

        styles [
          "player-prompt-stack",
        ]

        Gtk.Revealer player_sponsorblock_revealer {
          reveal-child: false;
          transition-type: slide_left;
          transition-duration: 200;
          halign: end;

          child: Gtk.Button player_sponsorblock_skip_button {
            halign: end;
            margin-end: 0;
            clicked => $OnSponsorBlockSkipButtonClicked();

            styles [
              "player-edge-prompt-button",
              "player-sponsorblock-skip-button",
            ]

            child: Gtk.Box {
              orientation: horizontal;
              spacing: 8;
              halign: center;
              valign: center;

              Gtk.Image player_sponsorblock_icon {
                icon-name: "media-seek-forward-symbolic";
                pixel-size: 16;

                styles [
                  "player-prompt-icon",
                ]
              }

              Gtk.Label player_sponsorblock_label {
                label: "Skip Sponsor";

                styles [
                  "player-prompt-label",
                ]
              }
            };
          };
        }

        Gtk.Revealer player_resume_revealer {
          reveal-child: false;
          transition-type: slide_left;
          transition-duration: 200;
          halign: end;

          child: Gtk.Button player_resume_button {
            halign: end;
            margin-end: 0;
            clicked => $OnResumeButtonClicked();

            styles [
              "player-edge-prompt-button",
              "player-resume-prompt-button",
            ]

            child: Gtk.Box {
              orientation: horizontal;
              spacing: 8;
              halign: center;
              valign: center;

              Gtk.Image {
                icon-name: "media-playback-start-symbolic";
                pixel-size: 16;

                styles [
                  "player-prompt-icon",
                ]
              }

              Gtk.Label player_resume_label {
                label: "Resume";

                styles [
                  "player-prompt-label",
                ]
              }
            };
          };
        }

        Gtk.Revealer player_restart_revealer {
          reveal-child: false;
          transition-type: slide_left;
          transition-duration: 200;
          halign: end;

          child: Gtk.Button player_restart_button {
            halign: end;
            margin-end: 0;
            clicked => $OnRestartButtonClicked();

            styles [
              "player-edge-prompt-button",
              "player-resume-restart-button",
            ]

            child: Gtk.Box {
              orientation: horizontal;
              spacing: 8;
              halign: center;
              valign: center;

              Gtk.Image {
                icon-name: "media-skip-backward-symbolic";
                pixel-size: 16;

                styles [
                  "player-prompt-icon",
                ]
              }

              Gtk.Label player_restart_label {
                label: "Restart from beginning";

                styles [
                  "player-prompt-label",
                ]
              }
            };
          };
        }
      }

      [overlay]
      Gtk.Revealer player_osd_revealer {
        halign: center;
        valign: end;
        reveal-child: false;
        transition-type: crossfade;
        transition-duration: 250;
        can-target: false;

        styles [
          "player-osd-revealer",
        ]

        child: Gtk.Box player_osd_box {
          orientation: horizontal;
          spacing: 10;
          halign: center;
          valign: center;

          styles [
            "osd",
            "player-osd-badge",
          ]

          Gtk.Image player_osd_icon {
            icon-name: "media-playback-pause-symbolic";
            pixel-size: 20;

            styles [
              "player-osd-icon",
            ]
          }

          Gtk.Label player_osd_label {
            label: "Paused";

            styles [
              "player-osd-label",
            ]
          }
        };
      }
    };
  };
}
