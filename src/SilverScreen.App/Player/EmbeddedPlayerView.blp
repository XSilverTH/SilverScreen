using Gtk 4.0;
using Adw 1;

Adw.OverlaySplitView EmbeddedPlayerView {
  sidebar-position: start;
  collapsed: true;
  focusable: true;
  notify => $OnCommentsSidebarNotify();

  sidebar: Gtk.Box comments_sidebar_host {
    hexpand: false;
    vexpand: true;
  };

  content: Adw.OverlaySplitView player_queue_split_view {
    sidebar-position: end;
    collapsed: true;
    focusable: true;
    notify => $OnQueueSidebarNotify();

    sidebar: Gtk.Box player_queue_sidebar_host {
      hexpand: false;
      vexpand: true;
    };

    content: Gtk.Overlay player_overlay {
      hexpand: true;
      vexpand: true;

      styles [
        "embedded-player",
      ]
    };
  };
}
