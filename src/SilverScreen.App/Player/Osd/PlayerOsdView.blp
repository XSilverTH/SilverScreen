using Gtk 4.0;

Gtk.Revealer PlayerOsdView {
  halign: center;
  valign: end;
  reveal-child: false;
  transition-type: crossfade;
  transition-duration: 250;
  can-target: false;

  styles [
    "player-osd-revealer",
  ]

  child: Gtk.Box {
    orientation: horizontal;
    spacing: 10;
    halign: center;
    valign: center;
    can-target: false;

    styles [
      "osd",
      "player-osd-badge",
    ]

    Gtk.Image player_osd_icon {
      pixel-size: 20;
      accessible-role: presentation;

      styles [
        "player-osd-icon",
      ]
    }

    Gtk.Label player_osd_label {
      label: "";

      styles [
        "player-osd-label",
      ]
    }
  };
}
