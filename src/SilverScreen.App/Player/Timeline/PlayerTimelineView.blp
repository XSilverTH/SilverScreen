using Gtk 4.0;

Gtk.Box PlayerTimelineView {
  orientation: vertical;
  spacing: 2;
  hexpand: true;

  Gtk.Overlay player_timeline_overlay {
    child: Gtk.Scale player_timeline {
      draw-value: false;
      hexpand: true;
      sensitive: false;
      focusable: true;

      styles [
        "player-timeline",
      ]

      adjustment: Gtk.Adjustment {
        lower: 0;
        upper: 100;
        value: 0;
        step-increment: 1;
      };
    };

    [overlay]
    Gtk.Box player_scrub_cue {
      orientation: vertical;
      spacing: 2;
      halign: start;
      valign: end;
      margin-bottom: 24;
      visible: false;
      can-target: false;

      styles [
        "player-scrub-cue",
      ]

      Gtk.Box {
        orientation: horizontal;
        spacing: 8;
        halign: center;

        Gtk.Label player_scrub_time_label {
          label: "";

          styles [
            "player-scrub-time-label",
          ]
        }

        Gtk.Label player_scrub_delta_label {
          label: "";
          visible: false;

          styles [
            "player-scrub-delta-label",
          ]
        }
      }

      Gtk.Label player_scrub_chapter_label {
        label: "";
        visible: false;
        ellipsize: end;
        max-width-chars: 32;

        styles [
          "player-scrub-chapter-label",
        ]
      }
    }
  }

  Gtk.Box player_time_row {
    Gtk.Label player_position_label {
      label: "";
      xalign: 0;
      hexpand: true;

      styles [
        "caption",
        "player-time",
      ]
    }

    Gtk.Label player_duration_label {
      label: "";
      xalign: 1;

      styles [
        "caption",
        "player-time",
      ]
    }
  }
}
