        <ProjectReference Include="..\..\lib\Hi3Helper.SharpDiscordRPC\DiscordRPC\DiscordRPC.csproj"/>
        <ProjectReference Include="..\..\lib\YoutubeAPI\YoutubeAPI\YoutubeAPI.csproj"/>
        <ProjectReference Include="..\SilverScreen.Core\SilverScreen.Core.csproj"/>
        <InternalsVisibleTo Include="SilverScreen.Tests"/>
    </ItemGroup>

</Project>
